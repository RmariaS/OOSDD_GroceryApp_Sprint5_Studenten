<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Grocery.App.Views.ProductCategoriesView"
             Title="Producten in categorie">
    <VerticalStackLayout Padding="16">
        <Label Text="{Binding SelectedCategory.Name, StringFormat='Producten in: {0}'}"
               FontSize="20"
               FontAttributes="Bold"
               Margin="0,0,0,16"/>
        <CollectionView ItemsSource="{Binding ProductCategories}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="12">
                        <Label Text="{Binding ProductId, StringFormat='Product ID: {0}'}" FontSize="16"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Label Text="💡 Tip: Later kun je hier productnamen tonen via ProductService."
               TextColor="Gray"
               FontSize="12"
               VerticalOptions="EndAndExpand"/>
    </VerticalStackLayout>
</ContentPage>